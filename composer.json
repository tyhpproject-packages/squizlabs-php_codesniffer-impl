{
    "name": "tyhpdef/squizlabs-php_codesniffer-impl",
    "description": "Implementation package for tyhpdef/squizlabs-php_codesniffer. Require tyhpdef/squizlabs-php_codesniffer, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "3.13.6.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/php-ext-dom": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/squizlabs-php_codesniffer"
        }
    },
    "require": {
        "php": ">=8.2",
        "squizlabs/php_codesniffer": "3.13.6"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/php-ext-dom": "@dev"
    }
}
